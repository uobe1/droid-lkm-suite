#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Disposable-VM test for the standalone ipset core and hash types.
BB=/bin/busybox
IPSET=/usr/sbin/ipset
export PATH=/sbin:/bin:/usr/sbin:/usr/bin

"$BB" mount -t proc proc /proc
"$BB" mount -t sysfs sysfs /sys
if ! "$BB" mount -t devtmpfs devtmpfs /dev 2>/dev/null; then
	"$BB" mount -t tmpfs tmpfs /dev
	"$BB" mknod /dev/console c 5 1
	"$BB" mknod /dev/null c 1 3
fi
"$BB" mkdir -p /dev/pts /tmp
"$BB" mount -t devpts devpts /dev/pts 2>/dev/null

fail() {
	echo "DNSK_QEMU_FAIL $*"
	"$BB" poweroff -f
}

echo "DNSK_QEMU_IPSET_BOOT $(cat /proc/sys/kernel/osrelease)"
"$BB" insmod /modules/dnsk_ipset.ko || fail ipset_insmod
"$BB" dmesg | "$BB" grep -q 'ipset protocol 7' || fail ipset_marker
if [ -r /proc/net/ip_tables_matches ]; then
	"$BB" grep -qw set /proc/net/ip_tables_matches || fail xt_set_missing
	echo "DNSK_QEMU_XT_SET_OK"
fi
"$IPSET" create t hash:ip || fail create_hash_ip
"$IPSET" add t 10.0.0.1 || fail add_hash_ip
"$IPSET" test t 10.0.0.1 || fail test_hit
if "$IPSET" test t 10.0.0.2; then
	fail test_miss
fi
"$IPSET" create n hash:net || fail create_hash_net
"$IPSET" add n 10.0.0.0/8 || fail add_hash_net
"$IPSET" test n 10.1.2.3 || fail test_net_hit
"$IPSET" list n >/dev/null || fail list_hash_net
"$IPSET" destroy t || fail destroy_hash_ip
"$IPSET" destroy n || fail destroy_hash_net
unloaded=0
i=0
while [ "$i" -lt 10 ]; do
	if "$BB" rmmod dnsk_ipset 2>/dev/null; then
		unloaded=1
		break
	fi
	"$BB" sleep 1
	i=$((i + 1))
done
[ "$unloaded" -eq 1 ] || fail ipset_rmmod
echo "DNSK_QEMU_IPSET_OK"
"$BB" poweroff -f
