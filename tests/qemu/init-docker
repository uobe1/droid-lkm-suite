#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Docker 29.x baseline in the stock DDK VM: cgroup2, vfs storage and no
# network.  The image is imported from the Alpine minirootfs, so no registry
# access is needed.  Network/bridge/NAT is a separate mode.
BB=/bin/busybox
export PATH=/usr/bin:/bin:/sbin:/usr/sbin

"$BB" mount -t proc proc /proc
"$BB" mount -t sysfs sysfs /sys
if ! "$BB" mount -t devtmpfs devtmpfs /dev 2>/dev/null; then
	"$BB" mount -t tmpfs tmpfs /dev
	"$BB" mknod /dev/console c 5 1
	"$BB" mknod /dev/null c 1 3
fi
"$BB" mkdir -p /dev/pts /dev/shm /tmp /run /var/lib/docker \
	/var/lib/containerd /var/log /etc /sys/fs/cgroup
"$BB" mount -t devpts devpts /dev/pts 2>/dev/null
"$BB" mount -t tmpfs tmpfs /dev/shm 2>/dev/null || true
"$BB" ifconfig lo up 2>/dev/null || true
ln -sf /proc/self/fd/0 /dev/stdin
ln -sf /proc/self/fd/1 /dev/stdout
ln -sf /proc/self/fd/2 /dev/stderr
ln -sf /proc/self/fd /dev/fd

fail() {
	echo "DNSK_QEMU_FAIL $*"
	"$BB" tail -80 /var/log/dockerd.log 2>/dev/null
	"$BB" tail -40 /var/log/containerd.log 2>/dev/null
	"$BB" poweroff -f
}

if grep -q 'dnsk_lkm=1' /proc/cmdline; then
	"$BB" insmod /modules/dnsk_core.ko || fail dnsk_core_insmod
	"$BB" insmod /modules/dnsk_cgpids.ko || fail dnsk_cgpids_insmod
	echo "DNSK_CGPIDS_LKM_OK"
	if grep -q '^pids' /proc/cgroups; then
		fail cgpids_native_pids_present
	fi
fi

echo "DNSK_QEMU_DOCKER_BOOT $(cat /proc/sys/kernel/osrelease)"
"$BB" mount -t cgroup2 cgroup2 /sys/fs/cgroup || fail cgroup2_mount
if grep -q 'dnsk_lkm=1' /proc/cmdline; then
	echo "cgpids_lkm_controllers=$(cat /sys/fs/cgroup/cgroup.controllers 2>/dev/null)"
fi
iptables --version || fail iptables_missing
iptables -t nat -L -n >/dev/null 2>&1 || fail iptables_kernel

for opt in m p u i n U C T; do
	if "$BB" unshare -"$opt" true 2>/dev/null; then
		echo "ns_probe -$opt ok"
	else
		echo "ns_probe -$opt FAIL"
	fi
done

containerd >/var/log/containerd.log 2>&1 &
i=0
while [ ! -S /run/containerd/containerd.sock ] && [ "$i" -lt 60 ]; do
	sleep 1
	i=$((i + 1))
done
[ -S /run/containerd/containerd.sock ] || fail containerd_socket

# The rootfs is an initramfs; pivot_root is not usable there.
export DOCKER_RAMDISK=true
dockerd --containerd /run/containerd/containerd.sock \
	--data-root /var/lib/docker --exec-root /run/docker \
	--pidfile /run/docker.pid --storage-driver vfs \
	--ip6tables=false \
	--exec-opt native.cgroupdriver=cgroupfs \
	>/var/log/dockerd.log 2>&1 &
i=0
while ! docker info >/dev/null 2>&1 && [ "$i" -lt 120 ]; do
	sleep 1
	i=$((i + 1))
done
docker info >/dev/null 2>&1 || fail docker_info

ver=$(docker info --format '{{.ServerVersion}}' 2>/dev/null)
echo "docker_server=$ver"
case "$ver" in
29.*) ;;
*) fail "docker_version=$ver" ;;
esac

docker import /alpine.tar.gz alpine:local || fail docker_import
if docker run --rm --network none alpine:local /bin/sh -c \
	'echo DOCKER_CONTAINER_OK; cat /proc/1/cgroup; id'; then
	echo "DNSK_DOCKER_ISOLATED_OK"
	docker run --rm --network none --pids-limit 32 alpine:local /bin/sh -c \
		'n=0; while [ $n -lt 40 ]; do if (sleep 30 &) 2>/dev/null; then n=$((n+1)); else break; fi; done; \
		 echo pids_spawned=$n; cat /sys/fs/cgroup/pids.max; cat /sys/fs/cgroup/pids.current; \
		 cat /sys/fs/cgroup/pids.peak; cat /sys/fs/cgroup/pids.events' \
		|| fail docker_pids_limit
else
	echo "isolated_run_failed; trying host namespaces"
	docker run --rm --network host --pid host --ipc host --uts host \
		--cgroupns host alpine:local /bin/sh -c \
		'echo DOCKER_HOSTNS_OK; cat /proc/1/cgroup; id' || fail docker_hostns_run
	echo "DNSK_DOCKER_HOSTNS_ONLY"
fi

docker run --rm alpine:local /bin/sh -c \
	'echo BRIDGE_DEV; cat /proc/net/dev; ping -c1 -W1 172.17.0.1' \
	|| fail docker_bridge
echo "DNSK_DOCKER_BRIDGE_OK"

docker run -d --name dnsk-nat -p 18080:80 alpine:local /bin/sh -c \
	'while true; do printf "HTTP/1.0 200 OK\r\nContent-Length: 13\r\nConnection: close\r\n\r\nDOCKER_NAT_OK\n" | nc -l -p 80; done' \
	|| fail docker_nat_start
nat_ip=
i=0
while [ "$i" -lt 20 ]; do
	state=$(docker inspect -f '{{.State.Running}}' dnsk-nat 2>/dev/null)
	nat_ip=$(docker inspect -f '{{.NetworkSettings.Networks.bridge.IPAddress}}' dnsk-nat 2>/dev/null)
	[ "$state" = true ] && echo "$nat_ip" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' && break
	sleep 0.5
	i=$((i + 1))
done
echo "nat_container_state=$state nat_container_ip=$nat_ip"
nat_diag() {
	echo "nat diagnostics:"
	docker ps -a 2>&1 | tail -5
	docker logs dnsk-nat 2>&1 | tail -10
	docker inspect -f '{{json .NetworkSettings}}' dnsk-nat 2>&1 | tail -3
	iptables -t nat -S 2>&1 | tail -20
}
[ -n "$nat_ip" ] || { nat_diag; fail docker_nat_ip; }
wget -qO- --timeout=3 "http://$nat_ip/" | grep -q DOCKER_NAT_OK \
	|| { nat_diag; fail docker_nat_direct; }
host_ip=$(ifconfig -a 2>/dev/null | awk '/inet addr:/ {
	sub(/.*inet addr:/, ""); sub(/[[:space:]].*/, "");
	if ($0 !~ /^127\./) { print; exit }
}')
echo "nat_host_ip=$host_ip"
[ -n "$host_ip" ] || { ifconfig -a; nat_diag; fail docker_nat_no_hostip; }
wget -qO- --timeout=3 "http://$host_ip:18080/" | grep -q DOCKER_NAT_OK \
	|| { nat_diag; fail docker_nat_dnat; }
wget -qO- --timeout=3 http://127.0.0.1:18080/ | grep -q DOCKER_NAT_OK \
	|| { nat_diag; fail docker_nat; }
docker rm -f dnsk-nat >/dev/null 2>&1 || true
echo "DNSK_DOCKER_NAT_OK"

echo "DNSK_DOCKER_OK"
echo "DNSK_QEMU_OK"
"$BB" poweroff -f
