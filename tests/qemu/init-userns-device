#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# USER_NS spike on the beryl device Image: the merged dnsk_ns build owns the
# user namespace live path; ksud resolves its unexported imports.

BB=/bin/busybox
export PATH=/usr/bin:/bin:/sbin:/usr/sbin

"$BB" mount -t proc proc /proc
"$BB" mount -t sysfs sysfs /sys
if ! "$BB" mount -t devtmpfs devtmpfs /dev 2>/dev/null; then
	"$BB" mount -t tmpfs tmpfs /dev
	"$BB" mknod /dev/console c 5 1
	"$BB" mknod /dev/null c 1 3
	"$BB" mknod /dev/zero c 1 5
fi

fail() {
	echo "DNSK_QEMU_FAIL $*"
	"$BB" dmesg 2>/dev/null | grep -iE 'dnsk|userns|kernelsu|module|symbol' | tail -25
	"$BB" poweroff -f
}

if [ -x /selinux_load ] && [ -f /policy.gz ]; then
	"$BB" mkdir -p /sys/fs/selinux
	"$BB" mount -t selinuxfs selinuxfs /sys/fs/selinux || fail selinuxfs_mount
	"$BB" gunzip -c /policy.gz > /policy || fail policy_gunzip
	/selinux_load /policy /sys/fs/selinux/load || fail selinux_policy_load
	echo 0 > /sys/fs/selinux/enforce || fail selinux_permissive
fi

"$BB" mkdir -p /data/adb/ksu/bin /data/adb/ksu/lib /data/adb/modules
export LD_LIBRARY_PATH=/system/lib64
/insmod_force /modules/selpermissive.ko || fail selpermissive_insmod
/ksud late-load --kmi android16-6.12 --allow-shell || fail ksud_late_load
read e < /sys/fs/selinux/enforce 2>/dev/null
echo "DNSK_ENFORCE_AFTER_LATE=$e"
echo 0 > /sys/fs/selinux/enforce 2>/dev/null
read e < /sys/fs/selinux/enforce 2>/dev/null
echo "DNSK_ENFORCE_RESTORED=$e"
"$BB" sleep 10
echo 0 > /sys/fs/selinux/enforce || fail selinux_permissive
[ "$(cat /sys/fs/selinux/enforce)" = 0 ] || fail selinux_enforcing
echo "DNSK_SELINUX_AFTER_KSU=permissive"

# KSU su: sucompat matches execve of exactly /system/bin/su, replaces it
# with KSUD_PATH (/data/adb/ksud) and applies the root profile; only that
# domain may adjust SELinux policy, so the enforcing pass runs inside it.
"$BB" mkdir -p /data/adb/ksu/bin /system/bin
ln -sf /ksud /data/adb/ksud
ln -sf /ksud /system/bin/su
su_sh() { /exec_shell_su -s /bin/sh -c "$1"; }

/ksud insmod /modules/dnsk_core.ko || fail core_insmod
/ksud insmod /modules/dnsk_ns.ko gki=1 activate=1 || fail ns_insmod
echo "DNSK_USERNS_LKM_OK"

if [ -r /proc/dnsk/rw ]; then
	rw_cmd() {
		"$BB" printf '%s\n' "$1" >/proc/dnsk/rw
		"$BB" cat /proc/dnsk/rw
	}
	rw_info=$(rw_cmd 'info')
	echo "RW_INFO=$rw_info"
	echo "$rw_info" | grep -q 'rw=ready' || fail rw_info
	va=$(rw_cmd 'resolve init_user_ns' | \
		sed -n 's/^resolve init_user_ns //p')
	[ -n "$va" ] || fail rw_resolve
	pa=$(rw_cmd 'pa init_user_ns' | sed -n 's/^pa init_user_ns //p')
	pa=${pa#0x}
	[ -n "$pa" ] || fail rw_pa
	rw_cmd "read $va 8" | grep -q "^read $va " || fail rw_read_va
	rw_cmd "readp $pa 8" | grep -q "^readp $pa " || fail rw_read_pa
	rw_cmd 'read 1000 4' | grep -q 'error' || fail rw_reject_user
	rw_cmd 'read 0 4' | grep -q 'error' || fail rw_reject_zero
	i=0
	while [ "$i" -lt 10 ]; do
		rw_cmd 'selftest' | grep -q 'selftest pass' || \
			fail "rw_selftest_$i"
		i=$((i + 1))
	done
	echo "DNSK_RW_OK"
else
	fail rw_proc_missing
fi

# Host-namespace overlay stays on the untouched native path; the emulated
# userns path is exercised by userns_test below.
mkdir -p /tmp/ovlctl
"$BB" mount -t tmpfs tmpfs /tmp/ovlctl || fail ovl_ctl_tmpfs
mkdir -p /tmp/ovlctl/lower /tmp/ovlctl/upper /tmp/ovlctl/work /tmp/ovlctl/merged
mount -t overlay overlay \
	-o lowerdir=/tmp/ovlctl/lower,upperdir=/tmp/ovlctl/upper,workdir=/tmp/ovlctl/work \
	/tmp/ovlctl/merged || fail ovl_ctl_mount
echo "DNSK_OVL_INIT_NS=0"

/userns_test || fail userns_test
/userns_unpriv_test || fail userns_unpriv_test
echo "DNSK_USERNS_UNPRIV_OK"
/fuse_test || fail fuse_test
/mount_setattr_test || fail mount_setattr_selftest
echo "DNSK_MOUNT_SETATTR_SELFTEST_OK"
echo "DNSK_USERNS_OK"
echo "DNSK_QEMU_OK"

if [ -f /enforce ]; then
	echo 0 > /proc/sys/kernel/printk_ratelimit 2>/dev/null
	echo 10000 > /proc/sys/kernel/printk_ratelimit_burst 2>/dev/null
	# The root profile lands in u:r:ksu:s0, so the rules target ksu.
	cat > /ksu_rules <<'RULES'
allow ksu rootfs file { open read write execute getattr map create unlink setattr }
allow ksu rootfs dir { open read write getattr search add_name remove_name rmdir create mounton }
allow ksu rootfs lnk_file { read getattr }
allow ksu tmpfs file { open read write create unlink getattr setattr append map execute }
allow ksu tmpfs dir { open read write getattr search add_name remove_name rmdir create mounton }
allow ksu tmpfs lnk_file { read getattr }
allow ksu devtmpfs chr_file { open read write ioctl getattr }
allow ksu devtmpfs blk_file { open read write getattr ioctl }
allow ksu devtmpfs dir { open read getattr search add_name remove_name create }
allow ksu tmpfs filesystem { mount remount }
allow ksu ext4 filesystem { mount remount }
allow ksu rootfs filesystem { mount remount }
allow ksu unlabeled filesystem { mount remount unmount }
allow unlabeled unlabeled filesystem associate
allow ksu unlabeled file { open read write create unlink getattr setattr append map ioctl }
allow ksu unlabeled dir { open read write getattr search add_name remove_name rmdir create mounton }
allow ksu unlabeled lnk_file { read getattr }
allow ksu unlabeled chr_file { open read write ioctl getattr }
allow ksu unlabeled blk_file { open read write ioctl getattr }
allow ksu proc file { open read write getattr ioctl }
allow ksu proc dir { open read getattr search }
allow ksu sysfs file { open read write getattr }
allow ksu sysfs dir { open read getattr search }
allow ksu selinuxfs file { open read write getattr }
allow ksu selinuxfs dir { open read getattr search }
RULES
	/ksud sepolicy apply /ksu_rules || fail su_sepolicy
	su_sh 'read ctx < /proc/self/attr/current 2>/dev/null; echo "DNSK_SU_CTX=$ctx"; echo 1 > /sys/fs/selinux/enforce; echo "DNSK_SELINUX_ENFORCE=$(read e < /sys/fs/selinux/enforce; echo $e)"; /userns_test && /userns_unpriv_test && /fuse_test && /mount_setattr_test && echo "DNSK_USERNS_ENFORCE_OK"; poweroff -f || echo o > /proc/sysrq-trigger'
	if [ $? -ne 0 ]; then
		echo "DNSK_QEMU_FAIL userns_enforce"
		echo o > /proc/sysrq-trigger
	fi
fi

"$BB" poweroff -f
