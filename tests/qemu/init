#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Minimal arm64 initramfs init for the stock-GKI core smoke.
# Feature modules import non-exported kernel symbols and need the KernelSU
# loader; this stock insmod path therefore validates core only.
BB=/bin/busybox
export PATH=/sbin:/bin:/usr/sbin:/usr/bin

"$BB" mount -t proc proc /proc
"$BB" mount -t sysfs sysfs /sys
if ! "$BB" mount -t devtmpfs devtmpfs /dev 2>/dev/null; then
	"$BB" mount -t tmpfs tmpfs /dev
	"$BB" mknod /dev/console c 5 1
	"$BB" mknod /dev/null c 1 3
fi
"$BB" mkdir -p /dev/pts /tmp
"$BB" mount -t devpts devpts /dev/pts 2>/dev/null

fail() {
	echo "DNSK_QEMU_FAIL $*"
	"$BB" poweroff -f
}

echo "DNSK_QEMU_BOOT $(cat /proc/sys/kernel/osrelease)"
"$BB" insmod /modules/dnsk_core.ko || fail core_insmod
[ -e /proc/dnsk/status ] || fail core_status
"$BB" grep -q '^patch=ready' /proc/dnsk/status || fail patch_not_ready
"$BB" grep -q '^panic=ready' /proc/dnsk/status || fail panic_not_ready
echo "DNSK_QEMU_CORE_READY"
"$BB" rmmod dnsk_core || fail core_rmmod
if [ -e /proc/dnsk/status ]; then
	fail core_proc_stale
fi
echo "DNSK_QEMU_OK"
"$BB" poweroff -f
