#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Native USER_NS oracle (CONFIG_USER_NS=y, FUSE/OVERLAY built in).
# Same user-space tests as the beryl device gate, without any LKM or ksud.

BB=/bin/busybox
export PATH=/usr/bin:/bin:/sbin:/usr/sbin

"$BB" mount -t proc proc /proc
"$BB" mount -t sysfs sysfs /sys
if ! "$BB" mount -t devtmpfs devtmpfs /dev 2>/dev/null; then
	"$BB" mount -t tmpfs tmpfs /dev
	"$BB" mknod /dev/console c 5 1
	"$BB" mknod /dev/null c 1 3
	"$BB" mknod /dev/zero c 1 5
fi
"$BB" chmod 1777 /tmp 2>/dev/null || true

if [ -x /selinux_load ] && [ -f /policy.gz ]; then
	"$BB" mkdir -p /sys/fs/selinux
	"$BB" mount -t selinuxfs selinuxfs /sys/fs/selinux || fail selinuxfs_mount
	"$BB" gunzip -c /policy.gz > /policy || fail policy_gunzip
	/selinux_load /policy /sys/fs/selinux/load || fail selinux_policy_load
	if [ -x /ksud ]; then
		export LD_LIBRARY_PATH=/system/lib64
		while IFS= read -r rule; do
			[ -n "$rule" ] || continue
			/ksud sepolicy patch "$rule" || \
				fail "sepolicy_patch:$rule"
		done <<'EOF'
allow kernel rootfs file { open read write execute getattr map }
allow kernel rootfs dir { open read write getattr search add_name remove_name }
allow kernel rootfs chr_file { open read write ioctl getattr }
allow kernel rootfs lnk_file { read getattr }
allow kernel tmpfs file { open read write create unlink getattr setattr append map execute }
allow kernel tmpfs dir { open read write getattr search add_name remove_name rmdir create }
allow kernel tmpfs lnk_file { read getattr }
allow kernel devtmpfs chr_file { open read write ioctl getattr }
allow kernel devtmpfs dir { open read getattr search }
allow kernel proc file { open read write getattr ioctl }
allow kernel proc dir { open read getattr search }
allow kernel sysfs file { open read write getattr }
allow kernel sysfs dir { open read getattr search }
allow kernel cgroup file { open read write getattr }
allow kernel cgroup dir { open read write getattr search add_name remove_name }
allow kernel selinuxfs file { open read write getattr }
allow kernel selinuxfs dir { open read getattr search }
allow kernel fuse file { open read write getattr setattr }
allow kernel fuse dir { open read write getattr search add_name remove_name create }
allow kernel unlabeled file { open read write getattr }
EOF
	fi
	echo 1 > /sys/fs/selinux/enforce || fail selinux_enforce
	echo "DNSK_SELINUX_ENFORCE=$(cat /sys/fs/selinux/enforce)"
fi

fail() {
	echo "DNSK_QEMU_FAIL $*"
	"$BB" dmesg 2>/dev/null | tail -25
	"$BB" poweroff -f
}

mkdir -p /tmp/ovlctl
"$BB" mount -t tmpfs tmpfs /tmp/ovlctl || fail ovl_ctl_tmpfs
mkdir -p /tmp/ovlctl/lower /tmp/ovlctl/upper /tmp/ovlctl/work /tmp/ovlctl/merged
mount -t overlay overlay \
	-o lowerdir=/tmp/ovlctl/lower,upperdir=/tmp/ovlctl/upper,workdir=/tmp/ovlctl/work \
	/tmp/ovlctl/merged || fail ovl_ctl_mount
echo "DNSK_OVL_INIT_NS=0"

/userns_test || fail userns_test
/userns_unpriv_test || fail userns_unpriv_test
echo "DNSK_USERNS_UNPRIV_OK"
/fuse_test || fail fuse_test
/mount_setattr_test || fail mount_setattr_selftest
echo "DNSK_MOUNT_SETATTR_SELFTEST_OK"
echo "DNSK_USERNS_OK"
echo "DNSK_QEMU_OK"
"$BB" poweroff -f
