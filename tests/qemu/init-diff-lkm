#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# LKM side of the semantic differential.
#
# Same probes as init-diff-oracle, but on the device kernel with this suite's
# modules loaded.  The host diffs the two result files: any line that differs is
# a semantic difference between "what the kernel does natively" and "what the
# module makes it do", which is exactly what this step has to find.

BB=/bin/busybox
export PATH=/usr/bin:/bin:/sbin:/usr/sbin:/data/adb/modules/droid_lkm_suite/bin
export ANDROID_ROOT=/system ANDROID_DATA=/data

MODDIR=/data/adb/modules/droid_lkm_suite
CTL=$MODDIR/bin/dnskctl

"$BB" mount -t proc proc /proc
"$BB" mount -t sysfs sysfs /sys
if ! "$BB" mount -t devtmpfs devtmpfs /dev 2>/dev/null; then
	"$BB" mount -t tmpfs tmpfs /dev
	for n in "console 5 1" "null 1 3" "zero 1 5" "urandom 1 9" "tty 5 0"; do
		set -- $n
		"$BB" mknod "/dev/$1" c "$2" "$3"
	done
fi
"$BB" mkdir -p /tmp && "$BB" mount -t tmpfs tmpfs /tmp && "$BB" chmod 1777 /tmp
"$BB" mkdir -p /sys/fs/cgroup
"$BB" mount -t cgroup2 cgroup2 /sys/fs/cgroup 2>/dev/null

fail() {
	echo "DNSK_QEMU_FAIL $*"
	"$BB" dmesg 2>/dev/null | tail -20
	"$BB" poweroff -f
}

if [ -x /selinux_load ] && [ -f /policy.gz ]; then
	"$BB" mkdir -p /sys/fs/selinux
	"$BB" mount -t selinuxfs selinuxfs /sys/fs/selinux || fail selinuxfs_mount
	"$BB" gunzip -c /policy.gz > /policy || fail policy_gunzip
	/selinux_load /policy /sys/fs/selinux/load || fail selinux_policy_load
	echo 0 > /sys/fs/selinux/enforce || fail selinux_permissive
fi

export LD_LIBRARY_PATH=/system/lib64
"$BB" mkdir -p /data/adb/ksu/bin /data/adb/ksu/lib /data/adb/modules
/insmod_force /modules/selpermissive.ko || fail selpermissive_insmod
/ksud late-load --kmi android16-6.12 --allow-shell || fail ksud_late_load
"$BB" sleep 10
echo 0 > /sys/fs/selinux/enforce || fail selinux_permissive

dnskctl() { "$BB" sh "$CTL" "$@"; }

# Load every module whose semantics are under test.
dnskctl load core || fail load_core
#
# netfilter and ipset are part of the differential too: the device kernel has
# none of CONFIG_NETFILTER_XT_MATCH_ADDRTYPE / XT_TARGET_REJECT / XT_MATCH_RECENT
# / IP_SET / NF_TABLES, so their behaviour only exists while the modules are
# loaded.  Omitting them would compare "absent" against "native" and call it a
# module defect.
#
# Which modules to load is a parameter, not a fixed list.
#
# Loading every module in one boot does not fit the TCG budget: netfilter alone is
# ~12 MB and its symbol work dominates, so a single full run times out before it
# finishes and produces no comparable output at all.  One module per round is the
# same rule the unload gate already follows.
#
LOADLIST=${DNSK_DIFF_LOAD:-ns devtmpfs cgpids tmpfsx}
for f in $LOADLIST; do
	[ -f "$MODDIR/kmi/"*/"dnsk_$f.ko" ] || continue
	dnskctl load "$f" || echo "DNSK_LOAD_FAIL $f"
done

echo "DIFF_BEGIN lkm"
sh /diff_probe.sh lkm 2>&1
echo "DIFF_END lkm"

"$BB" poweroff -f
