#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Minimal boot check for the beryl device kernel Image under QEMU virt.

BB=/bin/busybox
export PATH=/usr/bin:/bin:/sbin:/usr/sbin

"$BB" mount -t proc proc /proc
"$BB" mount -t sysfs sysfs /sys
if ! "$BB" mount -t devtmpfs devtmpfs /dev 2>/dev/null; then
	"$BB" mount -t tmpfs tmpfs /dev
	"$BB" mknod /dev/console c 5 1
	"$BB" mknod /dev/null c 1 3
fi

echo "DNSK_DEVICE_BOOT $(uname -r)"
echo "DNSK_DEVICE_KERNEL_OK"
echo "DNSK_QEMU_OK"
"$BB" poweroff -f
