#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Native tmpfs xattr/ACL oracle (CONFIG_TMPFS_XATTR/POSIX_ACL=y).
# Same test items as the beryl device gate, without any LKM.

BB=/bin/busybox
export PATH=/usr/bin:/bin:/sbin:/usr/sbin

"$BB" mount -t proc proc /proc
"$BB" mount -t sysfs sysfs /sys
if ! "$BB" mount -t devtmpfs devtmpfs /dev 2>/dev/null; then
	"$BB" mount -t tmpfs tmpfs /dev
	"$BB" mknod /dev/console c 5 1
	"$BB" mknod /dev/null c 1 3
	"$BB" mknod /dev/zero c 1 5
fi

fail() {
	echo "DNSK_QEMU_FAIL $*"
	"$BB" dmesg 2>/dev/null | tail -20
	"$BB" poweroff -f
}

"$BB" mkdir -p /early /late /acl /aclled

if [ -x /selinux_load ] && [ -f /policy.gz ]; then
	"$BB" mkdir -p /sys/fs/selinux
	"$BB" mount -t selinuxfs selinuxfs /sys/fs/selinux || fail selinuxfs_mount
	"$BB" gunzip -c /policy.gz > /policy || fail policy_gunzip
	/selinux_load /policy /sys/fs/selinux/load || fail selinux_policy_load
	echo 0 > /sys/fs/selinux/enforce || fail selinux_permissive
	echo "DNSK_SELINUX_POLICY_OK enforce=0"
	if [ -x /ksud ] && [ -f /modules/selpermissive.ko ]; then
		"$BB" mkdir -p /data/adb/ksu/bin /data/adb/modules
		export LD_LIBRARY_PATH=/system/lib64
		/insmod_force /modules/selpermissive.ko || fail selpermissive_insmod
		/ksud late-load --kmi android16-6.12 --allow-shell || fail ksud_late_load
		"$BB" sleep 10
		echo 0 > /sys/fs/selinux/enforce || fail selinux_permissive
		echo "DNSK_SELINUX_AFTER_KSU=permissive"
		ln -sf /ksud /data/adb/ksud
		ln -sf /ksud /system/bin/su
		su_sh() { /exec_shell_su -s /bin/sh -c "$1"; }
	fi
fi
mount -t tmpfs tmpfs /early || fail early_mount
mount -t tmpfs tmpfs /late || fail late_mount

echo data >/early/f || fail early_file
/xattr_test /early/f || fail early_xattr
echo data >/late/f || fail late_file
/xattr_test /late/f || fail late_xattr

echo data >/early/g || fail evict_file
/xattr_test /early/g keep || fail evict_set
"$BB" rm -f /early/g
"$BB" sync

# Native tmpfs has no "acl" mount flag: ACLs are on by default when
# CONFIG_TMPFS_POSIX_ACL is set (shmem_fill_super sets SB_POSIXACL).
mount -t tmpfs tmpfs /acl || fail acl_mount
/acl_test /acl existing || fail acl_test
echo "DNSK_TMPFSX_ACL_OK"
/acl_test /acl inherit || fail acl_inherit
echo "DNSK_TMPFSX_ACL_INHERIT_OK"

mount -t tmpfs tmpfs /aclled || fail acl_legacy_mount
/acl_test /aclled existing || fail acl_legacy
echo "DNSK_TMPFSX_ACL_LEGACY_OK"
/acl_test /aclled inherit || fail acl_legacy_inherit
echo "DNSK_TMPFSX_ACL_LEGACY_INHERIT_OK"

echo "DNSK_TMPFSX_OK"
echo "DNSK_QEMU_OK"

if [ -f /enforce ] && [ -x /ksud ] && [ -f /modules/selpermissive.ko ]; then
	echo 0 > /proc/sys/kernel/printk_ratelimit 2>/dev/null
	echo 10000 > /proc/sys/kernel/printk_ratelimit_burst 2>/dev/null
	cat > /ksu_rules <<'RULES'
allow ksu rootfs file { open read write execute getattr map create unlink setattr }
allow ksu rootfs dir { open read write getattr search add_name remove_name rmdir create mounton }
allow ksu rootfs lnk_file { read getattr }
allow ksu tmpfs file { open read write create unlink getattr setattr append map execute }
allow ksu tmpfs dir { open read write getattr search add_name remove_name rmdir create mounton }
allow ksu tmpfs lnk_file { read getattr }
allow ksu devtmpfs chr_file { open read write ioctl getattr }
allow ksu devtmpfs dir { open read getattr search add_name remove_name create }
allow ksu tmpfs filesystem { mount remount }
allow ksu rootfs filesystem { mount remount }
allow ksu unlabeled filesystem { mount remount unmount }
allow unlabeled unlabeled filesystem associate
allow ksu proc file { open read write getattr ioctl }
allow ksu proc dir { open read getattr search }
allow ksu sysfs file { open read write getattr }
allow ksu sysfs dir { open read getattr search }
allow ksu selinuxfs file { open read write getattr }
allow ksu selinuxfs dir { open read getattr search }
RULES
	/ksud sepolicy apply /ksu_rules || fail su_sepolicy
	su_sh 'read ctx < /proc/self/attr/current 2>/dev/null; echo "DNSK_SU_CTX=$ctx"; echo 1 > /sys/fs/selinux/enforce; echo "DNSK_SELINUX_ENFORCE=$(read e < /sys/fs/selinux/enforce; echo $e)"; /xattr_test /early/f && /xattr_test /late/f && /acl_test /acl existing && /acl_test /acl inherit && /acl_test /aclled existing && /acl_test /aclled inherit && echo "DNSK_TMPFSX_ENFORCE_OK"; poweroff -f || echo o > /proc/sysrq-trigger'
	if [ $? -ne 0 ]; then
		echo "DNSK_QEMU_FAIL tmpfsx_enforce"
		echo o > /proc/sysrq-trigger
	fi
fi

"$BB" poweroff -f
