#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Devtmpfs trigger=bus gate: boot the *device* Image (CONFIG_DEVTMPFS=n), load
# only dnsk_devtmpfs.ko with trigger=bus, then prove with a bus-notify probe
# that the node exists before ADD notify and after DEL notify.  Finally reload
# with the default trigger=entry and prove the same probe sees no node.
#
# Cloned from the diff job's LKM side: ksud insmod is required because the
# module imports unexported symbols (override_creds, set_fs_root,
# shmem_init_fs_context, ...).  trigger_probe.ko only uses exported symbols, so
# it is loaded with plain busybox insmod.

BB=/bin/busybox
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
export ANDROID_ROOT=/system ANDROID_DATA=/data

MODDIR=/data/adb/modules/droid_lkm_suite
KO=$MODDIR/kmi/android16-6.12
PARAM=/sys/module/dnsk_devtmpfs/parameters

fail() {
	echo "DNSK_QEMU_FAIL $*"
	"$BB" dmesg | "$BB" tail -20
	"$BB" poweroff -f
}

"$BB" mount -t proc proc /proc
"$BB" mount -t sysfs sysfs /sys
"$BB" mkdir -p /dev /tmp /mnt
"$BB" mount -t tmpfs tmpfs /dev
"$BB" mknod /dev/console c 5 1 2>/dev/null
"$BB" mknod /dev/null c 1 3 2>/dev/null
"$BB" chmod 1777 /tmp

echo "DNSK_TRIGGER_BUS_BOOT $(cat /proc/sys/kernel/osrelease)"

# dnsk_devtmpfs imports nine symbols that are not exported (set_fs_pwd,
# kern_path_create, kern_path_locked, done_path_create, vfs_getattr, vfs_mknod,
# revert_creds, aarch64_insn_patch_text_nosync, kallsyms_lookup_name), so a
# plain insmod can never resolve them.  ksud insmod binds them from
# /proc/kallsyms; `late-load` takes no module path, which is why the previous
# attempt died with 57 "Unknown symbol" lines.
/ksud insmod "$KO/dnsk_devtmpfs.ko" gki=1 activate=1 trigger=bus ||
	fail devtmpfs_bus_insmod
[ "$(cat "$PARAM/trigger" 2>/dev/null)" = "bus" ] || fail trigger_not_bus
# trigger_active is a bool module parameter, so sysfs prints Y/N (not 1/0); the
# previous assertion compared against 1 and failed on a module that had already
# entered bus mode (dmesg: "trigger=bus active").
ta=$(cat "$PARAM/trigger_active" 2>/dev/null)
case $ta in
Y|1) : ;;
*) fail "trigger_active=$ta" ;;
esac
echo "DNSK_TRIGGER_BUS_READY"

# The node window belongs to the bus notifier, so devtmpfs has to be mounted
# for nodes to exist at all.
"$BB" mount -t devtmpfs devtmpfs /dev || fail devtmpfs_mount
"$BB" dmesg | "$BB" grep -qF 'droidspaces_devtmpfs: trigger=bus active' ||
	fail no_bus_active_marker

# Probe #1: trigger=bus -- ADD and DEL callbacks must both see the node.
"$BB" insmod "$KO/trigger_probe.ko" || fail trigger_probe_insmod
"$BB" dmesg | "$BB" grep -qF 'DNSK_TRIGGER_BUS_ADD_NODE_PRESENT' ||
	fail bus_add_node_absent
"$BB" dmesg | "$BB" grep -qF 'DNSK_TRIGGER_BUS_DEL_NODE_PRESENT' ||
	fail bus_del_node_absent
"$BB" rmmod trigger_probe 2>/dev/null

# Rollback: same boot, back to the default trigger=entry, then re-run the same
# probe as the control.  A failed rmmod is not fatal here: the next run simply
# boots without trigger=bus, and nothing persistent is changed.
"$BB" umount /dev 2>/dev/null
# dmesg is a ring buffer: the first load's "trigger=bus active" line stays there
# after a reload, so scoping matters.  Record the line count and only inspect
# what the rollback reload adds -- otherwise the stale line reads as "the bus
# marker survived", which is exactly the false failure this gate hit once.
dmesg_before=$("$BB" dmesg 2>/dev/null | "$BB" wc -l)
if "$BB" rmmod dnsk_devtmpfs 2>/dev/null; then
	/ksud insmod "$KO/dnsk_devtmpfs.ko" gki=1 activate=1 ||
		fail devtmpfs_entry_insmod
	[ "$(cat "$PARAM/trigger" 2>/dev/null)" = "entry" ] ||
		fail trigger_not_entry
	ta=$(cat "$PARAM/trigger_active" 2>/dev/null)
	case $ta in
	N|0) : ;;
	*) fail "trigger_active_after_rollback=$ta" ;;
	esac
	"$BB" dmesg 2>/dev/null | "$BB" tail -n "+$((dmesg_before + 1))" |
		"$BB" grep -qF 'droidspaces_devtmpfs: trigger=bus active' &&
		fail bus_marker_survived_rollback
	"$BB" mount -t devtmpfs devtmpfs /dev || fail devtmpfs_mount2
	"$BB" insmod "$KO/trigger_probe.ko" || fail trigger_probe_insmod2
	"$BB" dmesg | "$BB" grep -qF 'DNSK_TRIGGER_ENTRY_ADD_NO_NODE' ||
		fail entry_add_node_present
	"$BB" dmesg | "$BB" grep -qF 'DNSK_TRIGGER_ENTRY_DEL_NO_NODE' ||
		fail entry_del_node_present
	echo "DNSK_TRIGGER_ROLLBACK_OK"
else
	echo "DNSK_TRIGGER_ROLLBACK_SKIPPED rmmod_failed"
fi

echo "DNSK_QEMU_OK"
"$BB" poweroff -f
