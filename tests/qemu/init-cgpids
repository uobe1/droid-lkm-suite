#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# cgroup v2 pids differential: same script runs on the native oracle
# (CONFIG_CGROUP_PIDS=y) and on the virtual controller (oracle-nopids +
# dnsk_cgpids).  Compare the marked values across both runs.

BB=/bin/busybox
export PATH=/usr/bin:/bin:/sbin:/usr/sbin

"$BB" mount -t proc proc /proc
"$BB" mount -t sysfs sysfs /sys
if ! "$BB" mount -t devtmpfs devtmpfs /dev 2>/dev/null; then
	"$BB" mount -t tmpfs tmpfs /dev
	"$BB" mknod /dev/console c 5 1
	"$BB" mknod /dev/null c 1 3
fi
"$BB" mkdir -p /sys/fs/cgroup

fail() {
	echo "DNSK_QEMU_FAIL $*"
	echo "DNSK_DEVICE_RELEASE=$(uname -r)"
	"$BB" dmesg 2>/dev/null | grep -iE 'version magic|should be|module|vermagic|signature|dnsk|Exec format' | tail -30
	"$BB" dmesg 2>/dev/null | tail -10
	"$BB" poweroff -f
}

"$BB" mount -t cgroup2 cgroup2 /sys/fs/cgroup || fail cgroup2_mount

if grep -q 'dnsk_lkm=1' /proc/cmdline; then
	if [ -x /ksud ]; then
		export LD_LIBRARY_PATH=/system/lib64
		"$BB" mkdir -p /data/adb/ksu/bin /data/adb/ksu/lib /data/adb/modules
		/ksud late-load --kmi android16-6.12 --allow-shell || fail ksud_late_load
		/ksud insmod /modules/dnsk_core.ko || fail dnsk_core_ksud_insmod
		/ksud insmod /modules/dnsk_cgpids.ko || fail dnsk_cgpids_ksud_insmod
	elif [ -x /insmod_force ]; then
		/insmod_force /modules/dnsk_core.ko || fail dnsk_core_insmod
		/insmod_force /modules/dnsk_cgpids.ko || fail dnsk_cgpids_insmod
	else
		"$BB" insmod /modules/dnsk_core.ko || fail dnsk_core_insmod
		"$BB" insmod /modules/dnsk_cgpids.ko || fail dnsk_cgpids_insmod
	fi
	echo "DNSK_CGPIDS_LKM_OK"
	if grep -q '^pids' /proc/cgroups; then
		fail cgpids_native_pids_present
	fi
fi
echo "DNSK_CGPIDS_CONTROLLERS=$(cat /sys/fs/cgroup/cgroup.controllers)"

echo +pids > /sys/fs/cgroup/cgroup.subtree_control || fail root_subtree_write
echo "DNSK_CGPIDS_ROOT_SUBTREE=$(cat /sys/fs/cgroup/cgroup.subtree_control)"

"$BB" mkdir /sys/fs/cgroup/t || fail mkdir_t
echo +pids > /sys/fs/cgroup/t/cgroup.subtree_control || fail t_subtree_write
"$BB" mkdir /sys/fs/cgroup/t/a || fail mkdir_a
test -e /sys/fs/cgroup/t/a/pids.max || fail no_pids_files
read max_before < /sys/fs/cgroup/t/a/pids.max || fail read_max_before
echo "DNSK_CGPIDS_MAX_BEFORE=$max_before"
echo 3 > /sys/fs/cgroup/t/a/pids.max || fail pids_max_write
read max_after < /sys/fs/cgroup/t/a/pids.max || fail read_max
echo "DNSK_CGPIDS_MAX=$max_after"

echo $$ > /sys/fs/cgroup/t/a/cgroup.procs || fail move_shell
read current_shell < /sys/fs/cgroup/t/a/pids.current || fail read_shell
echo "DNSK_CGPIDS_CURRENT_SHELL=$current_shell"

n=0
while [ "$n" -lt 10 ]; do
	if (sleep 30 &) 2>/dev/null; then
		n=$((n + 1))
	else
		break
	fi
done
echo "DNSK_CGPIDS_SPAWNED=$n"
read current_after < /sys/fs/cgroup/t/a/pids.current || fail read_current
read peak_after < /sys/fs/cgroup/t/a/pids.peak || fail read_peak
read events_after < /sys/fs/cgroup/t/a/pids.events || fail read_events
echo "DNSK_CGPIDS_CURRENT=$current_after"
echo "DNSK_CGPIDS_PEAK=$peak_after"
echo "DNSK_CGPIDS_EVENTS=$events_after"

# Re-open headroom before migrating: the limit run left the cgroup full.
echo 10 > /sys/fs/cgroup/t/a/pids.max || fail raise_limit
"$BB" mkdir /sys/fs/cgroup/t/b || fail mkdir_b
sh -c 'sleep 30 & echo $! > /sys/fs/cgroup/t/b/cgroup.procs' || fail migrate_child
sleep 1
read a_after < /sys/fs/cgroup/t/a/pids.current || fail read_a_after
read b_after < /sys/fs/cgroup/t/b/pids.current || fail read_b_after
echo "DNSK_CGPIDS_A_AFTER_MIGRATE=$a_after"
echo "DNSK_CGPIDS_B_AFTER_MIGRATE=$b_after"

echo "DNSK_CGPIDS_OK"
echo "DNSK_QEMU_OK"
"$BB" poweroff -f
