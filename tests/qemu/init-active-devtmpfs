#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Disposable-VM test for active device lifecycle hooks; the module stays pinned.
BB=/bin/busybox
export PATH=/sbin:/bin:/usr/sbin:/usr/bin

"$BB" mount -t proc proc /proc
"$BB" mount -t sysfs sysfs /sys
if ! "$BB" mount -t devtmpfs devtmpfs /dev 2>/dev/null; then
	"$BB" mount -t tmpfs tmpfs /dev
	"$BB" mknod /dev/console c 5 1
	"$BB" mknod /dev/null c 1 3
fi
"$BB" mkdir -p /dev/pts /tmp
"$BB" mount -t devpts devpts /dev/pts 2>/dev/null

fail() {
	echo "DNSK_QEMU_FAIL $*"
	"$BB" poweroff -f
}

echo "DNSK_QEMU_DEVTMPFS_BOOT $(cat /proc/sys/kernel/osrelease)"
"$BB" insmod /modules/dnsk_devtmpfs.ko gki=1 activate=1 || fail devtmpfs_activate
"$BB" dmesg | "$BB" grep -q 'device lifecycle active' || fail ready_marker
ready=$("$BB" cat /sys/module/dnsk_devtmpfs/parameters/ready 2>/dev/null)
[ "$ready" = "Y" ] || [ "$ready" = "1" ] || fail "ready=$ready"
echo "DNSK_ACTIVE_DEVTMPFS_OK ready=$ready"
"$BB" poweroff -f
