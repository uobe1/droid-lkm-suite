#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# UFW + Fail2ban gate on the beryl Image, using the LKM netfilter stack.

BB=/bin/busybox
export PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin

"$BB" mount -t proc proc /proc
"$BB" mount -t sysfs sysfs /sys
if ! "$BB" mount -t devtmpfs devtmpfs /dev 2>/dev/null; then
	"$BB" mount -t tmpfs tmpfs /dev
	"$BB" mknod /dev/console c 5 1
	"$BB" mknod /dev/null c 1 3
	"$BB" mknod /dev/zero c 1 5
fi
"$BB" mkdir -p /dev/pts /run /tmp
"$BB" mount -t devpts devpts /dev/pts 2>/dev/null

fail() {
	echo "DNSK_QEMU_FAIL $*"
	"$BB" dmesg 2>/dev/null | grep -iE 'dnsk|netfilter|ipset|xt_|module' | tail -20
	[ -f /var/log/fail2ban.log ] && tail -20 /var/log/fail2ban.log
	"$BB" poweroff -f
}

if [ -x /selinux_load ] && [ -f /policy.gz ]; then
	"$BB" mkdir -p /sys/fs/selinux
	"$BB" mount -t selinuxfs selinuxfs /sys/fs/selinux || fail selinuxfs_mount
	"$BB" gunzip -c /policy.gz > /policy || fail policy_gunzip
	/selinux_load /policy /sys/fs/selinux/load || fail selinux_policy_load
	echo 0 > /sys/fs/selinux/enforce || fail selinux_permissive
fi

"$BB" mkdir -p /data/adb/ksu/bin /data/adb/ksu/lib /data/adb/modules
export LD_LIBRARY_PATH=/system/lib64
/insmod_force /modules/selpermissive.ko || fail selpermissive_insmod
/ksud late-load --kmi android16-6.12 --allow-shell || fail ksud_late_load
"$BB" sleep 10
echo 0 > /sys/fs/selinux/enforce || fail selinux_permissive
[ "$(cat /sys/fs/selinux/enforce)" = 0 ] || fail selinux_enforcing
echo "DNSK_SELINUX_AFTER_KSU=permissive"

/ksud insmod /modules/dnsk_core.ko || fail core_insmod
/ksud insmod /modules/dnsk_netfilter.ko gki=1 activate=1 || fail netfilter_insmod
/ksud insmod /modules/dnsk_ipset.ko || fail ipset_insmod
echo "DNSK_NETFILTER_LKM_OK"

# UFW and Fail2ban call plain iptables; force the legacy backend so the
# rules land in the tables this kernel actually has.
ln -sf /sbin/iptables-legacy /sbin/iptables || fail iptables_link
ln -sf /sbin/ip6tables-legacy /sbin/ip6tables || fail ip6tables_link
ln -sf /sbin/iptables-legacy-restore /sbin/iptables-restore || fail iptables_restore_link
ln -sf /sbin/ip6tables-legacy-restore /sbin/ip6tables-restore || fail ip6tables_restore_link
ln -sf /sbin/iptables-legacy-save /sbin/iptables-save || fail iptables_save_link
ln -sf /sbin/ip6tables-legacy-save /sbin/ip6tables-save || fail ip6tables_save_link

ufw --force reset >/dev/null || fail ufw_reset
ufw default deny incoming || fail ufw_default
ufw allow 22/tcp || fail ufw_allow
ufw --force enable || fail ufw_enable
ufw status verbose | grep -q "Status: active" || fail ufw_status
iptables -S | grep -q "ufw-before-input" || fail ufw_rules
echo "DNSK_UFW_OK"

mkdir -p /etc/fail2ban /var/log /run/fail2ban /var/lib/fail2ban
cat >/etc/fail2ban/jail.local <<'EOF'
[DEFAULT]
backend = polling
bantime = 60
findtime = 60
maxretry = 1

[sshd]
enabled = true
logpath = /var/log/auth.log
port = ssh
maxretry = 1

[sshd-ddos]
enabled = false
EOF
: >/var/log/auth.log
fail2ban-client -x start || fail f2b_start
"$BB" sleep 3
TS=$("$BB" date "+%b %e %H:%M:%S")
echo "$TS localhost sshd[1234]: Failed password for root from 10.9.8.7 port 2222 ssh2" >>/var/log/auth.log
"$BB" sleep 12
fail2ban-client status sshd | grep -q "10.9.8.7" || fail f2b_ban
iptables -S | grep -q "10.9.8.7" || fail f2b_rule
echo "DNSK_FAIL2BAN_OK"

echo "DNSK_APPS_OK"
echo "DNSK_QEMU_OK"
"$BB" poweroff -f
