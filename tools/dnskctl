#!/system/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# dnskctl is the only supported user-space entry point for loading droid-lkm-
# suite modules.  It never writes boot partitions and never fakes status.

set -eu

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
if [ "$(basename -- "$SCRIPT_DIR")" = "bin" ]; then
	MODDIR=$(dirname -- "$SCRIPT_DIR")
else
	MODDIR=$SCRIPT_DIR
fi
STATE_DIR=${DNSK_STATE_DIR:-/data/adb/dnsk}
SUPPORTED="$MODDIR/supported_kmis.txt"
KSUD=${DNSK_KSUD:-}
BUSYBOX=${DNSK_BUSYBOX:-/data/adb/ksu/bin/busybox}

usage() {
	cat <<'EOF'
usage: dnskctl <command> [args]

commands:
  probe [--json]            show device/KMI/ksud/cgroup facts
  cap [--json]              show core capability/status
  status [--json]           show loaded modules and /proc/dnsk/status
  preflight [feature]       run device-side preflight (default: core)
  load <feature>            ksud insmod a feature module
  unload <feature>          rmmod a feature module (core checks refs)
  profile <name>            load a named profile
  enable|disable            allow/skip core auto-load on the next boot
  logs [lines]              tail the module state logs
  boot-begin|boot-ok|boot-check
  doctor [--last-panic]     collect dmesg/pstore/panic evidence
  cgroup-prep [--plan]      detect cgroup v1/v2 paths; does not modify them
  cgroup-prep --bind <root> bind existing /dev/{memcg,cpuctl,cpuset,blkio}
                            directories into <root> at the same names
  cgroup-prep --delegate <dir>
                            enable cpuset/cpu/io/memory/pids in <dir>'s
                            cgroup.subtree_control (cgroup v2 only)
  storage-loop create <img> <size> [ext4|f2fs]
                            create a sparse loop image (512M/2G); no mount
  storage-loop remove <img> umount (best effort) and delete the image

--json prints a single-line JSON object; exit status still reflects errors.
EOF
}

die() { echo "dnskctl: $*" >&2; exit 1; }

# json_str prints one JSON string literal without jq/python.  Backslashes and
# double quotes are escaped; newlines, carriage returns and tabs become spaces
# so a value can never break the single-line object it lives in.
json_str() {
	_json_flat=$(printf '%s' "$1" | LC_ALL=C tr '\n\r\t' '   ')
	_json_esc=$(printf '%s' "$_json_flat" | LC_ALL=C sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
	printf '"%s"' "$_json_esc"
}

json_bool() {
	if [ "$1" = yes ] || [ "$1" = true ] || [ "$1" = 1 ]; then
		printf 'true'
	else
		printf 'false'
	fi
}

need_root() {
	[ "$(id -u)" -eq 0 ] || die "run through: su -c '<command>' (or sudo in Termux for non-ksud tools)"
}

resolve_kmi() {
	release=$(uname -r)
	android=$(printf '%s\n' "$release" | sed -n 's/.*android\([0-9][0-9]*\).*/\1/p')
	series=$(printf '%s\n' "$release" | sed -n 's/^\([0-9][0-9]*\.[0-9][0-9]*\)\..*/\1/p')
	[ -n "$android" ] && [ -n "$series" ] || return 1
	kmi=android${android}-${series}
	if [ -f "$SUPPORTED" ] && ! grep -Fqx "$kmi" "$SUPPORTED"; then
		return 1
	fi
	printf '%s\n' "$kmi"
}

find_ksud() {
	if [ -n "$KSUD" ] && [ -x "$KSUD" ]; then printf '%s\n' "$KSUD"; return 0; fi
	for p in /data/adb/ksud /data/adb/ksu/bin/ksud; do
		[ -x "$p" ] && { printf '%s\n' "$p"; return 0; }
	done
	command -v ksud 2>/dev/null || return 1
}

find_busybox() {
	if [ -x "$BUSYBOX" ]; then printf '%s\n' "$BUSYBOX"; return 0; fi
	command -v busybox 2>/dev/null || true
}

module_path() {
	feature=$1
	kmi=$(resolve_kmi) || die "unsupported or ambiguous KMI: $(uname -r)"
	printf '%s/kmi/%s/dnsk_%s.ko\n' "$MODDIR" "$kmi" "$feature"
}

module_modinfo() {
	LC_ALL=C tr '\000' '\n' < "$1" | \
		LC_ALL=C sed -n "s/.*$2=\([0-9A-Za-z._-][0-9A-Za-z._-]*\).*/\1/p" | \
		head -n 1
}

check_abi_stamps() {
	ko=$1
	abi_profile=$(sed -n 's/^abi_profile=//p' "$MODDIR/policy.conf" 2>/dev/null | head -n 1)
	[ -n "$abi_profile" ] || die "policy.conf has no abi_profile; refusing to guess"
	module_profile=$(module_modinfo "$ko" dnsk_abi_profile)
	[ -n "$module_profile" ] || die "module has no dnsk_abi_profile stamp: $ko"
	[ "$module_profile" = "$abi_profile" ] || \
		die "module ABI profile $module_profile does not match policy $abi_profile: $ko"
	for pair in dnsk_page_size:page_size \
		    dnsk_max_skb_frags:max_skb_frags \
		    dnsk_cgroup_subsys_count:cgroup_subsys_count; do
		mkey=${pair%%:*}
		pkey=${pair#*:}
		expected=$(sed -n "s/^${pkey}=//p" "$MODDIR/policy.conf" 2>/dev/null | head -n 1)
		[ -n "$expected" ] || die "policy.conf has no $pkey; refusing to guess"
		got=$(module_modinfo "$ko" "$mkey")
		[ "$got" = "$expected" ] || \
			die "module $mkey=$got does not match policy $pkey=$expected: $ko"
	done
}

is_loaded() {
	name=$1
	bb=$(find_busybox)
	if [ -n "$bb" ]; then
		"$bb" lsmod 2>/dev/null | grep -q "^${name}[[:space:]]"
	else
		lsmod 2>/dev/null | grep -q "^${name}[[:space:]]"
	fi
}

do_probe() {
	json=0
	for arg in "$@"; do
		case "$arg" in
		--json) json=1 ;;
		*) die "probe [--json]" ;;
		esac
	done
	release=$(uname -r)
	kmi=$(resolve_kmi 2>/dev/null || echo unsupported)
	uid=$(id -u)
	page_size=$(getconf PAGE_SIZE 2>/dev/null || echo unknown)
	if [ -r /sys/kernel/btf/vmlinux ]; then btf=yes; else btf=no; fi
	ksud=$(find_ksud 2>/dev/null || echo missing)
	if is_loaded dnsk_core; then core_loaded=yes; else core_loaded=no; fi
	if [ -r /sys/fs/cgroup/cgroup.controllers ]; then
		controllers=$(cat /sys/fs/cgroup/cgroup.controllers 2>/dev/null)
	else
		controllers=unreadable
	fi
	if [ "$json" = 1 ]; then
		printf '{"release":%s,"kmi":%s,"uid":%s,"page_size":%s,"btf":%s,' \
			"$(json_str "$release")" "$(json_str "$kmi")" "$uid" \
			"$(json_str "$page_size")" "$(json_bool "$btf")"
		printf '"ksud":%s,"module_dir":%s,"core_loaded":%s,"cgroup2_controllers":%s,' \
			"$(json_str "$ksud")" "$(json_str "$MODDIR")" \
			"$(json_bool "$core_loaded")" "$(json_str "$controllers")"
		printf '"cgroup_v1":{'
		first=1
		for p in /dev/memcg /dev/cpuctl /dev/cpuset /dev/blkio; do
			[ "$first" = 1 ] || printf ','
			first=0
			if [ -d "$p" ]; then present=yes; else present=no; fi
			printf '%s:%s' "$(json_str "$p")" "$(json_bool "$present")"
		done
		printf '}}\n'
		return 0
	fi
	printf 'release: %s\n' "$release"
	printf 'kmi: %s\n' "$kmi"
	printf 'uid: %s\n' "$uid"
	printf 'page_size: %s\n' "$page_size"
	printf 'btf: %s\n' "$btf"
	printf 'ksud: %s\n' "$ksud"
	printf 'module_dir: %s\n' "$MODDIR"
	printf 'core_loaded: %s\n' "$core_loaded"
	printf 'cgroup2_controllers: %s\n' "$controllers"
	for p in /dev/memcg /dev/cpuctl /dev/cpuset /dev/blkio; do
		printf '%s: %s\n' "$p" "$([ -d "$p" ] && echo present || echo absent)"
	done
}

do_cap() {
	json=0
	for arg in "$@"; do
		case "$arg" in
		--json) json=1 ;;
		*) die "cap [--json]" ;;
		esac
	done
	if [ "$json" = 1 ]; then
		if [ -r /proc/dnsk/status ]; then
			raw=$(cat /proc/dnsk/status 2>/dev/null || true)
			printf '{"available":true,"raw":%s}\n' "$(json_str "$raw")"
		else
			printf '{"available":false}\n'
		fi
		return 0
	fi
	if [ -r /proc/dnsk/status ]; then
		cat /proc/dnsk/status
	else
		echo "core not loaded: /proc/dnsk/status missing" >&2
		return 1
	fi
}

dnsk_module_names() {
	bb=$(find_busybox)
	if [ -n "$bb" ]; then
		"$bb" lsmod 2>/dev/null || true
	else
		lsmod 2>/dev/null || true
	fi | grep -E '^dnsk_' | awk '{print $1}'
}

do_status() {
	json=0
	for arg in "$@"; do
		case "$arg" in
		--json) json=1 ;;
		*) die "status [--json]" ;;
		esac
	done
	if [ "$json" = 1 ]; then
		printf '{"modules":['
		first=1
		for m in $(dnsk_module_names); do
			[ "$first" = 1 ] || printf ','
			first=0
			printf '%s' "$(json_str "$m")"
		done
		if [ -r /proc/dnsk/status ]; then
			core_status=$(cat /proc/dnsk/status 2>/dev/null || true)
			printf '],"core_status":%s}\n' "$(json_str "$core_status")"
		else
			printf '],"core_status":null}\n'
		fi
		return 0
	fi
	echo "== modules =="
	dnsk_module_names || true
	echo "== core status =="
	if [ -r /proc/dnsk/status ]; then cat /proc/dnsk/status
	else echo "not loaded"; fi
}

do_preflight() {
	feature=${1:-core}
	ko=$(module_path "$feature")
	[ -s "$ko" ] || die "module not shipped in this build: $ko"
	if [ "$feature" != core ] && ! is_loaded dnsk_core; then
		die "dnsk_core is not loaded; load core first"
	fi
	if [ -x "$MODDIR/bin/dnsk-preflight" ]; then
		set -- --kmi "$(resolve_kmi 2>/dev/null || true)" --supported "$SUPPORTED"
		case "$feature" in
		ipset|netfilter)
			xt_layout=$(sed -n 's/^xt_layout=//p' "$MODDIR/policy.conf" 2>/dev/null | head -n 1)
			[ -n "$xt_layout" ] || die "policy.conf has no xt_layout; refusing to guess"
			stamp=$(module_modinfo "$ko" dnsk_xt_layout)
			[ -n "$stamp" ] || die "module has no dnsk_xt_layout stamp: $ko"
			[ "$stamp" = "$xt_layout" ] || \
				die "module xt layout $stamp does not match policy $xt_layout: $ko"
			check_abi_stamps "$ko"
			set -- "$@" --xt-layout "$xt_layout"
			;;
		devtmpfs|ns|tmpfsx)
			check_abi_stamps "$ko"
			;;
		cgpids)
			check_abi_stamps "$ko"
			for pair in dnsk_cgroup_subsys_layout:cgroup_subsys_layout \
				    dnsk_seq_file_private:seq_file_private; do
				mkey=${pair%%:*}
				pkey=${pair#*:}
				expected=$(sed -n "s/^${pkey}=//p" "$MODDIR/policy.conf" 2>/dev/null | head -n 1)
				[ -n "$expected" ] || die "policy.conf has no $pkey; refusing to guess"
				got=$(module_modinfo "$ko" "$mkey")
				[ "$got" = "$expected" ] || \
					die "module $mkey=$got does not match policy $pkey=$expected: $ko"
			done
			seq_private=$(sed -n 's/^seq_file_private=//p' "$MODDIR/policy.conf" 2>/dev/null | head -n 1)
			[ -n "$seq_private" ] || die "policy.conf has no seq_file_private; refusing to guess"
			set -- "$@" --seq-private "$seq_private"
			;;
		esac
		set -- "$@" --feature "$feature"
		DNSK_KSUD=$(find_ksud 2>/dev/null || true)
		export DNSK_KSUD
		set +e
		"$MODDIR/bin/dnsk-preflight" "$@"
		rc=$?
		set -e
		return "$rc"
	fi
	echo "dnsk-preflight binary missing; refusing to guess" >&2
	return 1
}

do_load() {
	[ $# -eq 1 ] || die "load <feature>"
	need_root
	feature=$1
	ko=$(module_path "$feature")
	[ -s "$ko" ] || die "module not shipped in this build: $ko"
	if ! do_preflight "$feature"; then
		die "preflight failed: $feature (refusing to insmod)"
	fi
	ksud=$(find_ksud) || die "ksud not found (set DNSK_KSUD)"
	set -- "$ko"
	case "$feature" in
		ns) set -- "$@" gki=1 activate=1 ;;
		devtmpfs) set -- "$@" gki=1 activate=1 ;;
		netfilter) set -- "$@" gki=1 activate=1 ;;
	esac
	"$ksud" insmod "$@"
}

do_unload() {
	[ $# -eq 1 ] || die "unload <feature>"
	need_root
	feature=$1
	if ! is_loaded "dnsk_${feature}"; then
		echo "dnsk_${feature} is not loaded"
		return 0
	fi
	bb=$(find_busybox)
	[ -n "$bb" ] || die "busybox not found; cannot rmmod safely"
	if [ "$feature" = core ]; then
		if "$bb" lsmod 2>/dev/null | grep '^dnsk_' | grep -qv '^dnsk_core '; then
			die "feature modules still loaded; unload them first"
		fi
	fi
	"$bb" rmmod "dnsk_${feature}"
}

do_profile() {
	[ $# -eq 1 ] || die "profile <name>"
	need_root
	profile=$1
	case "$profile" in
	core) set -- core ;;
	docker-v2|droidspaces|nixos|ufw-fail2ban)
		set -- core ns devtmpfs netfilter ipset cgpids
		;;
	docker-v1)
		set -- core ns devtmpfs netfilter ipset
		;;
	userns-full) set -- core ns userns ;;
	tmpfs-native) set -- core tmpfsx ;;
	*) die "unknown profile: $profile" ;;
	esac
	for feature in "$@"; do
		ko=$(module_path "$feature")
		[ -s "$ko" ] || die "profile requires module not shipped in this build: $ko"
	done
	for feature in "$@"; do
		do_load "$feature"
	done
}

state_file() { printf '%s/%s\n' "$STATE_DIR" "$1"; }

do_enable() {
	need_root
	rm -f "$MODDIR/disable" "$(state_file disable)"
	echo "enabled: post-fs-data loads core on the next boot"
}

do_disable() {
	need_root
	mkdir -p "$STATE_DIR"
	: >"$(state_file disable)"
	: >"$MODDIR/disable" 2>/dev/null || true
	echo "disabled: post-fs-data skips loading until enabled"
}

do_logs() {
	lines=${1:-40}
	case "$lines" in
	''|*[!0-9]*) die "logs [lines]" ;;
	esac
	found=0
	for f in "$STATE_DIR"/logs/*; do
		[ -f "$f" ] || continue
		found=1
		echo "== $f =="
		tail -n "$lines" "$f"
	done
	[ "$found" = 1 ] || echo "no logs in $STATE_DIR/logs"
}

do_boot_begin() {
	mkdir -p "$STATE_DIR"
	boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)
	printf '%s\n' "$boot_id" > "$(state_file attempt)"
	rm -f "$(state_file ok)"
}

do_boot_ok() {
	mkdir -p "$STATE_DIR"
	boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)
	printf '%s\n' "$boot_id" > "$(state_file ok)"
}

do_boot_check() {
	attempt=$(cat "$(state_file attempt)" 2>/dev/null || true)
	ok=$(cat "$(state_file ok)" 2>/dev/null || true)
	current=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)
	if [ -n "$attempt" ] && [ "$attempt" != "$current" ] && [ "$attempt" != "$ok" ]; then
		echo "previous boot did not report success; safe mode"
		return 10
	fi
	return 0
}

do_doctor() {
	echo "== dmesg =="
	dmesg 2>/dev/null | grep -E 'dnsk|DNSK' | tail -200 || true
	echo "== pstore =="
	if [ -r /proc/last_kmsg ]; then
		grep -E 'DNSK_PANIC|dnsk' /proc/last_kmsg 2>/dev/null | tail -100 || true
	fi
	for f in /sys/fs/pstore/console-ramoops*; do
		[ -r "$f" ] || continue
		echo "== $f =="
		grep -E 'DNSK_PANIC|dnsk' "$f" 2>/dev/null | tail -100 || true
	done
	if [ -x "$MODDIR/bin/panic_decode.sh" ]; then
		"$MODDIR/bin/panic_decode.sh" "$@"
	fi
}

do_cgroup_prep() {
	if [ $# -eq 0 ] || [ "$1" = "--plan" ]; then
		[ $# -le 1 ] || die "cgroup-prep [--plan]"
		echo "cgroup2.controllers: $(cat /sys/fs/cgroup/cgroup.controllers 2>/dev/null || echo unreadable)"
		for p in /dev/memcg /dev/cpuctl /dev/cpuset /dev/blkio; do
			printf '%s: %s\n' "$p" "$([ -d "$p" ] && echo present || echo absent)"
		done
		echo "plan: bind v1 controllers into the container mount namespace or enable cgroup2 delegation; no writes performed"
		return 0
	fi
	case "$1" in
	--bind)
		[ $# -eq 2 ] || die "cgroup-prep --bind <target-root>"
		need_root
		target=$2
		[ -d "$target" ] || die "not a directory: $target"
		found=0
		for name in memcg cpuctl cpuset blkio; do
			src=/dev/$name
			[ -d "$src" ] || continue
			found=1
			mkdir -p "$target/$name" || die "mkdir failed: $target/$name"
			mount --bind "$src" "$target/$name" || \
				die "bind mount failed: $src -> $target/$name"
			echo "bound: $src -> $target/$name"
		done
		[ "$found" = 1 ] || die "no cgroup v1 controller directory under /dev; nothing to bind"
		;;
	--delegate)
		[ $# -eq 2 ] || die "cgroup-prep --delegate <cgroup2-dir>"
		need_root
		dir=$2
		[ -d "$dir" ] || die "not a directory: $dir"
		[ -r "$dir/cgroup.controllers" ] || \
			die "not a cgroup2 directory (no cgroup.controllers): $dir"
		[ -e "$dir/cgroup.subtree_control" ] || \
			die "not a cgroup2 directory (no cgroup.subtree_control): $dir"
		available=$(cat "$dir/cgroup.controllers" 2>/dev/null || true)
		want=
		for c in cpuset cpu io memory pids; do
			case " $available " in
			*" $c "*) want="$want $c" ;;
			esac
		done
		[ -n "$want" ] || die "no delegatable controllers in $dir/cgroup.controllers: ${available:-<empty>}"
		ok=0
		for c in $want; do
			if printf '+%s\n' "$c" > "$dir/cgroup.subtree_control" 2>/dev/null; then
				echo "delegated: $c"
				ok=$((ok + 1))
			else
				echo "dnskctl: could not delegate $c (parent may not have enabled it)" >&2
			fi
		done
		[ "$ok" -gt 0 ] || die "no controller could be enabled in $dir/cgroup.subtree_control"
		echo "subtree_control: $(cat "$dir/cgroup.subtree_control" 2>/dev/null || true)"
		;;
	*)
		die "cgroup-prep [--plan] | --bind <target-root> | --delegate <cgroup2-dir>"
		;;
	esac
}

do_storage_loop() {
	[ $# -ge 1 ] || die "storage-loop create <img> <size> [ext4|f2fs] | storage-loop remove <img>"
	action=$1
	shift
	case "$action" in
	create)
		[ $# -ge 2 ] && [ $# -le 3 ] || die "storage-loop create <img> <size> [ext4|f2fs]"
		img=$1
		size=$2
		fs=${3:-ext4}
		need_root
		case "$fs" in
		ext4|f2fs) ;;
		*) die "unsupported filesystem: $fs (ext4|f2fs)" ;;
		esac
		case "$img" in
		/*) ;;
		*) die "image path must be absolute: $img" ;;
		esac
		num=${size%[KkMmGg]}
		suffix=${size#"$num"}
		case "$num" in
		''|*[!0-9]*) die "size must look like 512M or 2G: $size" ;;
		esac
		[ -n "$suffix" ] || die "size needs a K/M/G suffix: $size"
		[ "$num" -gt 0 ] || die "size must be positive: $size"
		if [ -e "$img" ] || [ -L "$img" ]; then
			die "refusing to overwrite existing path: $img"
		fi
		mkfs=$(command -v "mkfs.$fs" 2>/dev/null || true)
		[ -n "$mkfs" ] || die "mkfs.$fs not found; install ${fs}progs (nothing created)"
		if command -v truncate >/dev/null 2>&1; then
			truncate -s "$size" "$img" || die "truncate failed: $img"
		else
			case "$suffix" in
			K|k) mult=1024 ;;
			M|m) mult=1048576 ;;
			G|g) mult=1073741824 ;;
			esac
			blocks=$((num * mult / 4096))
			dd if=/dev/zero of="$img" bs=4096 count=0 seek="$blocks" 2>/dev/null || \
				die "could not create sparse image: $img"
		fi
		set +e
		case "$fs" in
		ext4) "$mkfs" -q -F "$img" ;;
		f2fs) "$mkfs" -f "$img" ;;
		esac
		rc=$?
		set -e
		if [ "$rc" -ne 0 ]; then
			rm -f "$img"
			die "mkfs.$fs failed (rc=$rc); removed $img"
		fi
		printf 'created: %s (%s, %s)\n' "$img" "$size" "$fs"
		echo "not mounted by dnskctl; mount it explicitly when needed"
		;;
	remove)
		[ $# -eq 1 ] || die "storage-loop remove <img>"
		img=$1
		need_root
		if [ -L "$img" ]; then
			die "refusing to remove symlink: $img"
		fi
		if [ ! -e "$img" ]; then
			die "no such path: $img"
		fi
		if [ ! -f "$img" ]; then
			die "refusing to remove non-regular file: $img"
		fi
		if umount "$img" 2>/dev/null; then
			echo "unmounted: $img"
		fi
		rm -f "$img" || die "failed to remove: $img"
		echo "removed: $img"
		;;
	*)
		die "storage-loop create <img> <size> [ext4|f2fs] | storage-loop remove <img>"
		;;
	esac
}

cmd=${1:-help}
shift || true
case "$cmd" in
	probe) do_probe "$@" ;;
	cap) do_cap "$@" ;;
	status) do_status "$@" ;;
	preflight) do_preflight "$@" ;;
	load) do_load "$@" ;;
	unload) do_unload "$@" ;;
	profile) do_profile "$@" ;;
	enable) do_enable "$@" ;;
	disable) do_disable "$@" ;;
	logs) do_logs "$@" ;;
	boot-begin) do_boot_begin "$@" ;;
	boot-ok) do_boot_ok "$@" ;;
	boot-check) do_boot_check "$@" ;;
	doctor) do_doctor "$@" ;;
	cgroup-prep) do_cgroup_prep "$@" ;;
	storage-loop) do_storage_loop "$@" ;;
	help|-h|--help) usage ;;
	*) usage; exit 2 ;;
esac
