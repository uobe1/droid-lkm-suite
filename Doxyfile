# Doxyfile for userspace tools and public headers.
PROJECT_NAME           = "droid-lkm-suite userspace"
PROJECT_BRIEF          = "dnskctl, dnsk-preflight, packaging and host tools"
OUTPUT_DIRECTORY       = build/docs/doxygen-userspace
INPUT                  = tools core/include
RECURSIVE              = YES
FILE_PATTERNS          = *.c *.h
EXCLUDE_PATTERNS       = */vendor/* */build/* */tests/*
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
HTML_OUTPUT            = html
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = NO
EXTRACT_ALL            = NO
QUIET                  = NO
