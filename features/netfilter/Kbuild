ccflags-y += -DCONFIG_NF_TABLES_IPV4=1 -DCONFIG_NF_TABLES_IPV6=1 -DCONFIG_NF_TABLES_INET=1
ifneq ($(DNSK_XT_LAYOUT),)
ccflags-y += -DDNSK_XT_LAYOUT=$(DNSK_XT_LAYOUT)
endif
ifneq ($(DNSK_ABI_PROFILE),)
ccflags-y += -DDNSK_ABI_PROFILE=\"$(DNSK_ABI_PROFILE)\"
endif
ifneq ($(DNSK_PAGE_SIZE),)
ccflags-y += -DDNSK_PAGE_SIZE=$(DNSK_PAGE_SIZE)
endif
ifneq ($(DNSK_MAX_SKB_FRAGS),)
ccflags-y += -DDNSK_MAX_SKB_FRAGS=$(DNSK_MAX_SKB_FRAGS)
endif
ifneq ($(DNSK_CGROUP_SUBSYS_COUNT),)
ccflags-y += -DDNSK_CGROUP_SUBSYS_COUNT=$(DNSK_CGROUP_SUBSYS_COUNT)
endif
LINUXINCLUDE := -I$(src)/vendor/netfilter/compat $(LINUXINCLUDE)
ifeq ($(DNSK_XT_NOCOMPAT),1)
ccflags-y += -DDNSK_XT_NOCOMPAT=1
# Must stay ahead of every other include dir so the shim sees x_tables.h
# before the kernel tree and vendor copies.
LINUXINCLUDE := -I$(src)/../../core/include/compat_include $(LINUXINCLUDE)
endif
ccflags-y += -I$(src)/vendor/netfilter -I$(srctree)
ccflags-y += -I$(src)/../../core/include
ccflags-y += -std=gnu11 -Wno-declaration-after-statement
