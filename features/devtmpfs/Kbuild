obj-m := dnsk_devtmpfs.o

dnsk_devtmpfs-y := \
	vendor/devtmpfs/main.o vendor/devtmpfs/devtmpfs.o \
	vendor/devtmpfs/hooks.o vendor/devtmpfs/original.o \
	vendor/kallrecon/lib/core.o vendor/kallrecon/lib/access.o \
	vendor/kallrecon/lib/discover.o vendor/kallrecon/lib/symbol.o \
	vendor/kallrecon/lib/slide.o vendor/kallrecon/lib/fastboot.o \
	vendor/kallrecon/lib/hint.o vendor/kallrecon/lib/variant.o \
	vendor/kallrecon/lib/anchor.o

ccflags-y += -I$(src)/vendor/kallrecon/lib -I$(src)/vendor
ccflags-y += -I$(srctree)
ifneq ($(DNSK_ABI_PROFILE),)
ccflags-y += -DDNSK_ABI_PROFILE=\"$(DNSK_ABI_PROFILE)\"
endif
ifneq ($(DNSK_PAGE_SIZE),)
ccflags-y += -DDNSK_PAGE_SIZE=$(DNSK_PAGE_SIZE)
endif
ifneq ($(DNSK_MAX_SKB_FRAGS),)
ccflags-y += -DDNSK_MAX_SKB_FRAGS=$(DNSK_MAX_SKB_FRAGS)
endif
ifneq ($(DNSK_CGROUP_SUBSYS_COUNT),)
ccflags-y += -DDNSK_CGROUP_SUBSYS_COUNT=$(DNSK_CGROUP_SUBSYS_COUNT)
endif
ccflags-y += -I$(src)/../../core/include
ccflags-y += -std=gnu11 -Wno-declaration-after-statement
